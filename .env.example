# ====================================================================
# LABELCHECK ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. NEVER commit production .env!
# ====================================================================

# Backend Configuration
ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite:///./labelcheck.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Security & Authentication (Generate using: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-secure-random-secret-key-for-jwt-signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://labelcheck.vercel.app

# Frontend Configuration (for frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000
# VITE_APP_ENV=development
